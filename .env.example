# ── LLM provider ─────────────────────────────────────────────────────────────
# Lhassa auto-detects the provider from whichever API key you provide.
# You only need ONE key — Lhassa will use it for the voice pipeline, the
# built-in agent tool loop, AND vision tools automatically.
#
# Priority (first key found wins):
#   ANTHROPIC_API_KEY → anthropic   (claude-haiku-4-5-20251001)
#   OPENAI_API_KEY    → openai      (gpt-4o-mini)
#   GROQ_API_KEY      → groq        (llama-3.3-70b-versatile)  ← free tier
#   OPENROUTER_API_KEY → openrouter (anthropic/claude-haiku-4-5-20251001)
#   CEREBRAS_API_KEY  → cerebras    (llama3.3-70b)
#
# Set only the key(s) for the provider(s) you want to use:
GROQ_API_KEY=            # console.groq.com — free tier, good for getting started
# ANTHROPIC_API_KEY=     # console.anthropic.com — Claude models
# OPENAI_API_KEY=        # platform.openai.com — GPT models
# OPENROUTER_API_KEY=    # openrouter.ai — access many models with one key
# CEREBRAS_API_KEY=      # cloud.cerebras.ai — very fast inference

# Ollama — local, no key needed. Change base URL if running on another machine.
# OLLAMA_BASE_URL=http://localhost:11434

# ── Override provider / model (optional) ──────────────────────────────────────
# Only needed if you want to force a specific provider or model.
# By default these are auto-detected from the API key(s) above.
#
# LHASSA_LLM_PROVIDER=groq   # groq | anthropic | openai | openrouter | ollama | cerebras
# LHASSA_MODEL=llama-3.3-70b-versatile
#
# Model examples:
# groq:       llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# anthropic:  claude-sonnet-4-6, claude-haiku-4-5-20251001
# openai:     gpt-4o, gpt-4o-mini, o3-mini
# openrouter: anthropic/claude-sonnet-4-6, meta-llama/llama-3.3-70b-instruct
# ollama:     llama3.2, qwen2.5-coder, mistral
# cerebras:   llama3.1-8b, llama3.1-70b

# ── STT ───────────────────────────────────────────────────────────────────────
# Deepgram — free tier at console.deepgram.com → "Speech to Text"
DEEPGRAM_API_KEY=

# Language for speech recognition (BCP-47 code).
# Examples: en (English), es (Spanish), fr (French), de (German), pt (Portuguese)
# Full list: https://developers.deepgram.com/docs/languages
LHASSA_STT_LANGUAGE=en

# ── TTS ───────────────────────────────────────────────────────────────────────
# Cartesia — console.cartesia.ai
CARTESIA_API_KEY=

# Cartesia voice ID — browse at play.cartesia.ai
LHASSA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# ── Audio ─────────────────────────────────────────────────────────────────────
# Substring matched against PyAudio device names (case-insensitive).
# Linux default: "pipewire" — works on most systems with PipeWire audio.
# macOS/Windows: leave empty ("") to use the system default device.
# Set to "" to disable device matching and use the OS default.
LHASSA_MIC_NAME=

# ── Voice bridge (opt-in, Phase 6) ─────────────────────────────────────────────
# When on, the voice pipeline's turns are answered by the brain (memory +
# provider + episode) instead of a generic LLM. Off by default; also needs the
# Deepgram/Cartesia keys above to actually run audio.
#   truthy: 1 | true | yes   (default: 0 = off)
# LHASSA_VOICE_ENABLED=0

# ── Instance identity + brain DB (data spine) ─────────────────────────────────
# One instance, one owner — every row in the "grande" brain DB carries this id.
# LHASSA_INSTANCE_ID=inst_personal
#
# The "grande": append-only SQLite (WAL) source of truth.
# LHASSA_BRAIN_DB_PATH=~/.lhassa/brain.db
#
# The "chica": persistent working-memory cache, derived from the grande and
# independently clearable ("matas la chica → se regenera de la grande").
# LHASSA_CHICA_DB_PATH=~/.lhassa/chica.db
# Threshold at which the chica mechanically consolidates (LRU eviction of the
# least-recently-used NON-pinned items down to this count). No tokens, no LLM.
# LHASSA_CHICA_MAX_ITEMS=200
# Semantic consolidation (cheap-LLM second pass) ONLY fires when the chica is
# over LHASSA_CHICA_MAX_ITEMS. Set to 0 to disable and keep only the mechanical LRU.
# LHASSA_SEMANTIC_CONSOLIDATION=1
#
# Incremental backup mirror of the grande (brain.db).
# LHASSA_BACKUP_DIR=~/.lhassa/backups

# ── Security — signing + task-level allowlist ─────────────────────────────────
# Ed25519 private key location (public key written alongside as <path>.pub).
# LHASSA_SIGNING_KEY_PATH=~/.lhassa/keys/ed25519
#
# Repo names the task-level allowlist accepts as sync_repo objetivos. CSV → set;
# "*" (default) means allow any (dev). Separate from the command-level sudo
# allowlist in tools/privileged.
# LHASSA_ALLOWLIST_REPOS=*

# ── Approval frontier + autonomy knob (HITL per flow) ─────────────────────────
# After this many CONSECUTIVE human-origin approvals of the same (accion, actor)
# the action auto-approves. A denial resets the streak. Never global, never
# promotes an Origin's trust level.
# LHASSA_AUTONOMY_THRESHOLD=3
#
# High-risk actions that ALWAYS require human approval no matter the history;
# NEVER auto-promoted by the autonomy knob above. CSV → set.
# LHASSA_ALWAYS_APPROVE_ACTIONS=move_money,delete_data

# ── Integrations — MCP ("plug in, don't program") ─────────────────────────────
# Server definitions for the MCP client (JSON). Missing file → zero MCP tools
# (the brain runs fine with none).
# LHASSA_MCP_CONFIG_PATH=~/.config/lhassa/mcp.json

# ── Dashboard API ─────────────────────────────────────────────────────────────
LHASSA_API_HOST=127.0.0.1
LHASSA_API_PORT=7766
# Required when exposing the API beyond localhost. Send as:
#   Authorization: Bearer <token>
# Local 127.0.0.1 access works without a token.
# LHASSA_API_TOKEN=
# Comma-separated allowed browser origins. Defaults to localhost dashboard/dev.
# LHASSA_API_CORS_ORIGINS=http://127.0.0.1:7766,http://localhost:7766

# ── Logging ───────────────────────────────────────────────────────────────────
LHASSA_LOG_LEVEL=INFO
# Set to 1 to show live STT transcriptions in the terminal (helps debug wake word)
LHASSA_DEBUG=0

# ── Wake behaviour ────────────────────────────────────────────────────────────
# Seconds of silence before Lhassa goes back to sleep after being woken (default: 300).
# Lower values save API costs on idle sessions; higher values feel more responsive.
# LHASSA_WAKE_TIMEOUT=300

# ── LLM gateway (cost control) ─────────────────────────────────────────────────
# Single chokepoint for cloud-LLM calls: cache + budget + cost ledger.
#
# Daily output-token budget; 0 = unlimited (default). When exceeded, the gateway
# refuses further calls until the next day (UTC).
# LHASSA_LLM_DAILY_TOKEN_BUDGET=0
# Cache identical prompts so repeat questions never hit the cloud. Default on.
# LHASSA_LLM_CACHE=1
# Cache TTL in days — a stored answer older than this is a miss and gets purged.
# 0 = never expire.
# LHASSA_LLM_CACHE_TTL_DAYS=7
# Extra/override model pricing merged over the built-in gateway table (JSON
# object {"model-name": [input_per_1M, output_per_1M]}). Empty = built-in table
# only. Malformed JSON is logged and ignored (never crashes).
# LHASSA_PRICING_JSON=
# Kill-switch — a hard manual stop, independent of the daily token budget. When
# on, the gateway refuses every cloud-LLM call before it reaches a provider.
#   truthy: 1 | true | yes | on   (default: off)
# LHASSA_KILL_SWITCH=0

# ── Router — two axes + cascade ────────────────────────────────────────────────
# "rules" (default) → pick cheap/smart by hardness, route sensitive data to a
# zero-retention provider. "off" → always use LHASSA_MODEL (no routing).
# LHASSA_ROUTER=rules
# Cheap model for routine judgment / smart model for hard judgment. Both default
# to LHASSA_MODEL so a single-model setup needs no extra config.
# LHASSA_MODEL_CHEAP=
# LHASSA_MODEL_SMART=
# Token budget for the layered memory load when the brain wakes to think.
# LHASSA_CONTEXT_TOKEN_BUDGET=2000
# Token budget for a "minimal" context load — the tier the deterministic policy
# layer requests for routine/default judgment (no reflex flagged it hard).
# LHASSA_CONTEXT_TOKEN_BUDGET_MINIMAL=600

# ── Deterministic policy layer ("reflexes") ────────────────────────────────────
# Repos that reconcile themselves automatically (sync_repo, no judgment) the
# moment the watchlist sees a new commit. CSV of absolute paths; empty = no
# repo auto-syncs.
# LHASSA_AUTO_SYNC_REPOS=

# ── Budget soft-limit (router downgrade) ───────────────────────────────────────
# Once today's spend crosses this fraction of LHASSA_LLM_DAILY_TOKEN_BUDGET, the
# router never picks the smart model for a "hard" judgment. Only meaningful when
# the daily token budget is > 0.
# LHASSA_BUDGET_SOFT_PCT=0.8

# ── Deferred-task retry sweep (resilience) ─────────────────────────────────────
# A task the judgment path could not run (no provider / budget spent) is marked
# "diferida". Each heartbeat re-queues it once it has sat for at least this many
# seconds.
# LHASSA_DEFERRED_RETRY_BACKOFF=300
# After this many retries a still-deferred task is marked "rechazada" (terminal)
# instead of requeued indefinitely.
# LHASSA_DEFERRED_MAX_RETRIES=3

# ── Web search — Brave Search (optional but recommended) ─────────────────────
# More stable than DuckDuckGo. Free tier at api.search.brave.com/register
# Falls back to DuckDuckGo if not set.
# BRAVE_API_KEY=

# ── Microsoft Graph — Outlook email + calendar (optional) ────────────────────
#
# Setup:
#   1. portal.azure.com → Azure Active Directory → App registrations → New registration
#   2. Name: "Lhassa", type: Public client / native (no web redirect URI needed)
#   3. Authentication → enable "Allow public client flows"
#   4. API permissions → add: Mail.Read, Mail.Send, Calendars.Read, Calendars.ReadWrite
#   5. Copy Application (client) ID and Directory (tenant) ID below
#
# MS_TENANT_ID=
# MS_CLIENT_ID=

# ── Agent backend ────────────────────────────────────────────────────────────
# Auto-detected at startup:
#   - "claude_code" if the `claude` CLI is found in PATH (uses your Claude subscription)
#   - "builtin"     if not found (uses LHASSA_LLM_PROVIDER with a 10-step tool loop)
#
# Set LHASSA_AGENT_DIR to the directory you want Claude Code agents to work in.
# Uncomment LHASSA_AGENT_BACKEND only if you want to override the auto-detection.
#
# LHASSA_AGENT_BACKEND=claude_code
# LHASSA_AGENT_DIR=/home/yourname/code/myproject
#
# Max tool-calling iterations per agent run (default: 10).
# Increase for complex tasks that need more steps; decrease to limit API cost.
# LHASSA_MAX_AGENT_ITERATIONS=10

# ── Local AI coding CLI (run_ai_cli tool) ──────────────────────────────────────
# Which local AI coding CLI the run_ai_cli tool dispatches tasks to, taking
# advantage of your existing subscription. Options: claude | codex | opencode.
# Auto-detected from the first installed CLI if not set. Independent of
# LHASSA_AGENT_BACKEND and never affects it.
# LHASSA_AI_CLI=claude

# ── Delegated code work — harness override ─────────────────────────────────────
# Force which HarnessAdapter the router delegates code work to: opencode |
# claude | codex. Empty (default) → the router auto-picks the cheapest available
# muscle (free/metered before subscription).
# LHASSA_HARNESS=

# ── Vision tools (optional) ───────────────────────────────────────────────────
# analyze_screen and analyze_image need a vision-capable provider.
#
# LHASSA_VISION_PROVIDER controls which provider is used:
#   auto        — uses LHASSA_LLM_PROVIDER if it supports vision, else falls back
#                 to ANTHROPIC_API_KEY → OPENAI_API_KEY (default)
#   anthropic   — Claude Haiku (fast, great for screenshots)
#   openai      — GPT-4o-mini
#   openrouter  — any OpenRouter vision model (set LHASSA_VISION_MODEL)
#
# If LHASSA_LLM_PROVIDER is already anthropic, openai, or openrouter, vision
# works automatically — no extra keys needed.
#
# LHASSA_VISION_PROVIDER=auto
# LHASSA_VISION_MODEL=               # leave empty for provider default
# ANTHROPIC_API_KEY=                # console.anthropic.com
# OPENAI_API_KEY=                   # platform.openai.com

# ── GitHub (optional) ─────────────────────────────────────────────────────────
# Generate at github.com/settings/tokens — needs: repo, notifications
# GITHUB_TOKEN=

# ── Tool versioning ("versionado/rollback gratis") ─────────────────────────────
# Local git repo holding auto-created tools. Each candidate tool is committed on
# a candidate/<name> branch; approval = merge; rollback = git revert.
# Offline-first: this is a plain local repo. When GITHUB_TOKEN is set the
# versioning layer also pushes the branch and opens a PR, but never requires a
# token to work locally.
# LHASSA_TOOLS_REPO_DIR=~/.lhassa/tools

# ── Self-improvement — repeated-think detector ─────────────────────────────────
# How many times a (despertar_por, accion) pattern must repeat within the
# detection window before the repetition detector proposes minting a
# deterministic action to replace it.
# LHASSA_REPETITION_THRESHOLD=5

# ── Tool guardrails ───────────────────────────────────────────────────────────
# Uncomment to allow destructive shell commands (rm -rf, mkfs, etc.)
# LHASSA_ALLOW_DESTRUCTIVE_SHELL=0
#
# Restrict write_file to a specific directory tree
# LHASSA_FILE_WRITE_ROOT=/home/yourname/sandbox

# ── Output limits ─────────────────────────────────────────────────────────────
# Max characters captured from shell commands (voice default: 2000, agents default: 3000).
# Increase if agents need more context from long-running commands.
# LHASSA_SHELL_OUTPUT_MAX=2000
#
# Max characters returned by read_file (default: 4000).
# LHASSA_FILE_CONTENT_MAX=4000

# ── Audit log ─────────────────────────────────────────────────────────────────
# Max audit events kept in memory and in ~/.lhassa/audit.json (default: 100, minimum: 10).
# LHASSA_AUDIT_MAX=100

# ── Memory snapshots ──────────────────────────────────────────────────────────
# Seconds between periodic memory extractions during a live session (default: 1800 = 30 min).
# Reduces fact loss if Lhassa crashes before normal shutdown. Minimum: 60.
# LHASSA_MEMORY_SNAPSHOT_INTERVAL=1800

# ── Memory layer 4 — semantic retrieval ("si se ganó") ─────────────────────────
# On by default: load() adds a semantic layer — facts whose embedding is closest
# to the active query, after pinned/recent/tags. Lowest priority, so it truncates
# first and never touches the identity core.
# LHASSA_MEMORY_LAYER4=1
# Names an embedding model on the local/cloud provider; empty → a deterministic
# offline fallback embedder (hashing), so the layer works with no model configured.
# LHASSA_EMBEDDING_MODEL=
# How many top semantic matches the layer pulls in.
# LHASSA_MEMORY_SEMANTIC_TOPK=5
#
# Dedicated embeddings endpoint (separate from the LLM endpoint) — an
# OpenAI-compatible /v1/embeddings endpoint. Defaults to a local Ollama instance.
# Any connection/HTTP failure degrades silently to the offline hashing embedder.
# LHASSA_EMBEDDINGS_URL=http://localhost:11434
# LHASSA_EMBEDDINGS_MODEL=nomic-embed-text
# API key for hosted embedding endpoints (Ollama is keyless; set for cloud).
# Never written to settings.env — stays in .env (secret).
# LHASSA_EMBEDDINGS_API_KEY=

# ── Heartbeat seat + local model (routine "think" — distinct from chat) ────────
# The heartbeat/routine path uses its own provider, independent of the chat one
# above. It never blocks the do-and-sleep loop; a provider/budget error degrades
# to a deferred episode.
#
# Which provider the heartbeat/routine path prefers (default: auto).
#   auto   — use the local model when LHASSA_LOCAL_MODEL_URL is set, else opencode
#            when the opencode CLI is on PATH, else the cloud gateway
#   local  — force the local OpenAI-compatible endpoint below
#   cloud  — force the cost gateway (cloud LLM)
#   opencode | claude | codex — force that CLI provider (runs on your subscription)
# LHASSA_HEARTBEAT_PROVIDER=auto
#
# Local, OpenAI-compatible model endpoint for the heartbeat ($0, no key).
# Examples: Ollama http://127.0.0.1:11434/v1 , llama.cpp / LM Studio server.
# Empty (default) = no local backend configured; the provider degrades gracefully.
# LHASSA_LOCAL_MODEL_URL=
# The served model name at that endpoint (default: empty).
# LHASSA_LOCAL_MODEL=
#
# opencode CLI heartbeat (no local model server needed — uses your opencode creds).
# LHASSA_OPENCODE_BIN=opencode                        # binary name / path (default: opencode)
# LHASSA_OPENCODE_MODEL=opencode/deepseek-v4-flash-free  # cheap/free model for a routine beat
#
# Claude Code CLI provider (runs on your Claude subscription, no API key).
# LHASSA_CLAUDE_BIN=claude       # binary name / path (default: claude)
# LHASSA_CLAUDE_MODEL=           # model to request; empty (default) = the CLI's own default
#
# Fallback provider CHAIN for the routine/Telegram think, tried IN ORDER after the
# routine provider. Unavailable CLIs are skipped; "default" = the cloud gateway.
# LHASSA_FALLBACK_PROVIDERS=claude,codex,default
#
# Timeout (seconds) for a single CLI-provider call (claude/codex/opencode).
# LHASSA_CLI_TIMEOUT=300

# ── Privacy / pseudonymization hook ────────────────────────────────────────────
# Pseudonymize PII before sending context to a NON-local, non-zero-retention
# provider. When the active provider is local the data never leaves the machine,
# so the hook relaxes (no scrubbing) unless overridden here.
#   truthy: not in (0, false, "")   (default: 1 = on)
# LHASSA_PSEUDONYMIZE_REMOTE=1

# ── Telegram (optional, token-gated) ──────────────────────────────────────────
# Outbound alerts/reports + optional inbound polling. BOTH the bot token and chat
# id must be set to enable it; with no token Lhassa never touches the network.
# Create a bot via @BotFather; get your chat id from @userinfobot.
LHASSA_TELEGRAM_BOT_TOKEN=      # secret — leave empty to keep Telegram off
LHASSA_TELEGRAM_CHAT_ID=        # the one chat id Lhassa answers (numbers only)
# Inbound: long-poll for messages and answer them (default: 0 = off). Needs the
# token + chat id above; only the configured chat is honored.
# LHASSA_TELEGRAM_POLL=0
# Provider for the Telegram CHAT reply specifically (the tool-less brain think).
# Empty/"auto" (default) → the router's routine decision (the heartbeat seat).
# "default" pins the API cost gateway for faster replies without touching what
# flows / hard work think with.
# LHASSA_TELEGRAM_PROVIDER=

# ── Chat memory (rolling per-chat conversation history) ───────────────────────
# How many user+assistant PAIRS of a Telegram chat are kept in the in-memory
# rolling history and threaded back into the next brain think. Process-memory
# only — restarting the poller clears it (never persisted to disk).
# LHASSA_TELEGRAM_HISTORY_TURNS=8
# A history entry older than this many seconds is dropped on read, so an old
# conversation never leaks into a new one.
# LHASSA_TELEGRAM_HISTORY_TTL=7200
# Every this many user turns, the chat system prompt gets one extra line nudging
# the model to mark a durable fact with [[remember: ...]].
# LHASSA_CHAT_MEMORY_NUDGE_TURNS=6

# ── Org + work-flows ──────────────────────────────────────────────────────────
# Live org/flow execution switch. Off (default) → flows + org delegation run
# offline/stubbed and cost $0 (deterministic episodes only). On → task nodes run
# against a real model (needed e.g. for the live CV tailoring flow).
#   truthy: 1 | true | yes | on   (default: off)
# LHASSA_ORG_LIVE=0
#
# Standalone by default (empty role). "general" = the coordinator brain (routes
# typed tasks, never executes department work); "department" = an executor brain
# with its own identity/memory/permissions.
# LHASSA_ORG_ROLE=
# This brain's department name (only meaningful when LHASSA_ORG_ROLE=department).
# LHASSA_ORG_DEPARTMENT=
# Elastic org: the department set is CONFIG-DRIVEN (comma-separated), not code.
# LHASSA_ORG_DEPARTMENTS=optimization,documentation,finance
# The org CHART/topology file (JSON): 1 standalone brain up to an arbitrary-depth
# hierarchy you create/manage (via `lhassa org`). Missing file → derived from
# LHASSA_ORG_ROLE/LHASSA_ORG_DEPARTMENTS (a flat general+departments chart).
# LHASSA_ORG_TOPOLOGY_FILE=~/.lhassa/org.json
# Lhassa is the PERMANENT root administrator — the brain that always sits at the
# top of any org and is never removed or demoted.
# LHASSA_ROOT_ADMIN=lhassa
# Typed org RELATIONSHIPS overlay (reads/notifies/reviews/collaborates) — a graph
# separate from the command tree.
# LHASSA_ORG_RELATIONSHIPS_FILE=~/.lhassa/relationships.json
# Work-flows (trigger → task → gate → output graphs) are stored here.
# LHASSA_FLOWS_FILE=~/.lhassa/flows.json

# ── CV pipeline (the "Impossible-to-reject CV" work-flow) ─────────────────────
# Bootstrap the pipeline on a fresh env with:  lhassa seed apply cv
#   (list seeds with `lhassa seed list`) → recreates the "interns" department +
#   the CV work-flow, then drop your real CV at ~/.lhassa/cv/cv_largo.tex
#   (see LHASSA_CV_DIR).
#
# Directory holding the base CV (cv_largo.tex) and per-run exports (out/).
# LHASSA_CV_DIR=~/.lhassa/cv
# The stored work-flow id the Telegram → CV bridge runs for a CV posting
# (the id `lhassa seed apply cv` prints when it creates the flow).
# LHASSA_CV_FLOW_ID=<your-cv-flow-id>
# LaTeX engine used to compile the tailored CV .tex into a PDF before sending it
# over Telegram. Resolved via PATH; if missing, the bridge sends the raw .tex.
# Install "tectonic" (optional system dep) to get compiled PDFs.
# LHASSA_TECTONIC_BIN=tectonic

# ── Skills (first-class, SKILL.md format) ──────────────────────────────────────
# Skills live as folders here, each with a SKILL.md (YAML frontmatter +
# markdown instructions + optional resources) — the skills.md / Agent-Skills
# convention — or a home-grown JSON form.
# LHASSA_SKILLS_DIR=~/.lhassa/skills
# Curator lifecycle thresholds: no use for this many days -> "stale"; stale AND
# unused for this many more days -> "archived" (moved, never deleted).
# LHASSA_SKILL_STALE_DAYS=30
# LHASSA_SKILL_ARCHIVE_DAYS=90

# ── Modularity — registries, channels, plugins (elastic & modular) ────────────
# Which notify CHANNELS are active (comma-separated); each is a registered,
# swappable channel. Empty entries ignored; unknown names skipped with a warning.
# LHASSA_NOTIFY_CHANNELS=telegram,desktop
# Drop-in plugin directory: modules placed here are imported at startup so they
# can self-register providers/harnesses/channels/departments/actions WITHOUT
# editing core. Empty/missing → no external plugins loaded.
# LHASSA_PLUGINS_DIR=~/.lhassa/plugins

# ── Monitor watcher (the always-on, $0 "ear") ─────────────────────────────────
# A standing, deterministic loop that watches the environment cheaply (no tokens)
# and only wakes the brain / alerts on notable events. OFF by default — opt in via
# scripts/systemd/lhassa-monitor.service (which ships LHASSA_MONITOR_ENABLED=1) or
# `make install-monitor`. The module no-ops + exits when disabled.
#   truthy: 1 | true | yes | on   (default: 0 = off)
# LHASSA_MONITOR_ENABLED=0
# Idle cadence (seconds) — how often it checks while nothing is running.
# LHASSA_MONITOR_IDLE_INTERVAL=300
# Active cadence (seconds) — the short interval while a run IS executing.
# LHASSA_MONITOR_ACTIVE_INTERVAL=15
# The department the watcher attributes its episodes/alerts to.
# LHASSA_MONITOR_DEPARTMENT=interns
# Push a Telegram/desktop alert on important events (failures/health/approvals).
# On by default; episodes are always logged regardless.  (default: 1)
# LHASSA_MONITOR_NOTIFY=1
# Optionally spend a token on a richer live "think" per reaction — the only place
# the watcher can cost anything. OFF by default; also needs LHASSA_ORG_LIVE=1.
# LHASSA_MONITOR_THINK=0
# When on, react() turns each delegation from the monitor's report into a minted
# org_run task — findings become work. De-duped by fingerprint. OFF by default.
# LHASSA_MONITOR_DELEGATE=0
# A failure only counts while FRESH: episodes older than this many hours never
# enter the failure signal. 0 disables the age cutoff.
# LHASSA_MONITOR_FAILURE_WINDOW_H=24

# ── Judgment dispatch (close the think-loop) ───────────────────────────────────
# When on (default), the judgment branch parses the model's JSON reply and
# writes facts + mints tasks through the security machinery. Set to 0 to
# disable (log the answer, do nothing else).
# LHASSA_JUDGMENT_DISPATCH=1

# ── Watchlist senses ────────────────────────────────────────────────────────────
# Comma-separated absolute paths of git repos to watch for new commits. Empty =
# no repo watching. Missing or non-repo paths are skipped silently.
# LHASSA_WATCH_REPOS=
# JSON file of inbound Telegram message rules (loaded by the Telegram poller).
# Schema: [{"pattern": "<regex>", "accion": "<str>", "params": {}}]
# Missing or malformed file → off.
# LHASSA_WATCH_RULES_FILE=~/.lhassa/watch_rules.json

# ── Scheduled operative digest (the "digest" seed) ─────────────────────────────
# Local hours (0-23) the twice-daily "send_digest" task is scheduled for by
# `lhassa seed apply digest`.
# LHASSA_DIGEST_HOUR_MORNING=8
# LHASSA_DIGEST_HOUR_EVENING=21
# How the digest reads: "plain" (default) → the deterministic $0 template;
# "persona" → one cheap fast-model pass re-voices it naturally (any failure
# degrades to plain — it always arrives).
# LHASSA_DIGEST_STYLE=plain
# Language for the persona pass ("" keeps the template's language; e.g. "es").
# LHASSA_DIGEST_LANGUAGE=
# Add a short owner-facing personal check-in to the scheduled digest.
# Deterministic and $0. Off by default.
# LHASSA_DIGEST_PERSONAL_CHECKIN=0
