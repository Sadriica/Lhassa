---
import { readFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import Base from '@/layouts/Base.astro'
import Bi from '@/components/Bi.astro'

// Version read live from Lhassa's own pyproject.toml, so the footer never
// hardcodes a number that drifts from the real repo; same pattern as
// witara.site's "page declares its own weight" footer.
const pyprojectPath = fileURLToPath(new URL('../../../pyproject.toml', import.meta.url))
const pyproject = readFileSync(pyprojectPath, 'utf-8')
const versionMatch = pyproject.match(/^version\s*=\s*"([^"]+)"/m)
const version = versionMatch ? versionMatch[1] : '0.0.0'

const title = 'Lhassa · by Witara'
const titleEn = 'Lhassa · by Witara'
const description =
  'Construye el cerebro, alquila el cuerpo. Un cerebro personal y persistente, identidad más allá del modelo. / Build the brain, rent the body. A persistent personal brain, an identity beyond the model.'

const photos = [
  {
    id: 'potala', w: 880, h: 586, kb: 55,
    cap: { es: 'El Potala de noche, Lhasa', en: 'The Potala at night, Lhasa' },
    title: '20140505 Potala Palace at night', author: 'Windmemories', lic: 'CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:20140505_Potala_Palace_at_night.jpg',
  },
  {
    id: 'everest', w: 880, h: 586, kb: 70,
    cap: { es: 'Cara norte del Everest, Tíbet', en: 'Everest north face, Tibet' },
    title: 'Everest North Face toward Base Camp Tibet', author: 'Luca Galuzzi', lic: 'CC BY-SA 2.5',
    href: 'https://commons.wikimedia.org/wiki/File:Everest_North_Face_toward_Base_Camp_Tibet_Luca_Galuzzi_2006.jpg',
  },
  {
    id: 'banderas', w: 880, h: 660, kb: 102,
    cap: { es: 'Banderas de oración', en: 'Prayer flags' },
    title: 'Prayer flags - Tibet in 2017', author: 'cattan2011', lic: 'CC BY 2.0',
    href: 'https://commons.wikimedia.org/wiki/File:Prayer_flags_-_Tibet_in_2017.jpg',
  },
  {
    id: 'luna', w: 880, h: 586, kb: 72,
    cap: { es: 'Salida de luna en el Himalaya', en: 'Moonrise in the Himalaya' },
    title: 'Moonrise in himalaya (Binsar)', author: 'Rajborah123', lic: 'CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:Moonrise_in_himalaya(binsar_wild_life_sanctury).jpg',
  },
]
---
<Base title={title} titleEn={titleEn} description={description} ogImage="/og/home.png" path="/">
  <main id="main">
    <div class="lang-float">
      <button type="button" class="lang-toggle" aria-label="Cambiar idioma / Switch language">
        <span class="lang-es">EN</span><span class="lang-en">ES</span>
      </button>
    </div>

    <header class="hero" id="hero">
      <div class="hero-text">
        <div class="brand-plate">
          <img src="/brand/lhassa-mark.svg" alt="" width="44" height="44" aria-hidden="true" />
          <div>
            <p class="brand-name">Lhassa</p>
            <div class="brand-rule" aria-hidden="true"></div>
          </div>
        </div>
        <div>
          <h1>
            <Bi es="Construye el cerebro, alquila el cuerpo." en="Build the brain, rent the body." />
          </h1>
          <p class="hero-sub">
            <Bi
              es="Vigila en silencio mientras duermes. Recuerda lo que importa. Se gana, aprobación a aprobación, el derecho a actuar por su cuenta."
              en="It watches quietly while you sleep. It remembers what matters. It earns, one approval at a time, the right to act on its own."
            />
          </p>
        </div>
        <p class="label"><span class="finial">●</span> by Witara · Colombia · 2026</p>
      </div>
      <div class="hero-img">
        <img src="/img/obsidiana/potala.png" width="880" height="586" alt="El palacio de Potala de noche, Lhasa" fetchpriority="high" loading="eager" decoding="async" />
        <span class="imgcap"><Bi es="El Potala de noche · 55 KB" en="The Potala at night · 55 KB" /></span>
      </div>
    </header>

    <section id="que-es" class="que-es">
      <div class="inner narrow">
        <div class="section-rule" data-reveal><p class="label"><Bi es="Qué es" en="What it is" /></p><span class="dot" aria-hidden="true"></span></div>
        <p class="big" data-reveal>
          <Bi
            es="Lhassa es un cerebro personal y persistente. No es un chatbot con tareas programadas: es una identidad que vive despierta todo el día, a costo cero casi siempre, y que solo piensa (de verdad, con un modelo) cuando el criterio lo exige."
            en="Lhassa is a persistent personal brain. It is not a chatbot with scheduled tasks: it is an identity that stays awake all day, at zero cost almost always, and only thinks (really, with a model) when judgment truly demands it."
          />
        </p>
        <p class="big" data-reveal>
          <Bi
            es="Lo que dura no es el modelo que usa hoy: es quién es. Los modelos, los harnesses, las herramientas: todo eso se alquila, se cambia, se descarta. La memoria, el juicio, el historial de confianza, eso se queda. Consejo, no control: Lhassa no decide por ti; te ayuda a decidir, y solo actúa por su cuenta cuando ya se ganó ese permiso, contigo, con evidencia."
            en="What lasts is not the model it uses today: it is who it is. Models, harnesses, tools: all of that is rented, swapped, discarded. The memory, the judgment, the trust record, that stays. Counsel, not control: Lhassa does not decide for you; it helps you decide, and only acts on its own once it has earned that, with you, with evidence."
          />
        </p>
      </div>
    </section>

    <section id="rasgos" class="rasgos">
      <div class="inner">
        <div class="section-rule" data-reveal><p class="label"><Bi es="Los tres rasgos" en="The three traits" /></p><span class="dot" aria-hidden="true"></span></div>
        <h2 data-reveal><Bi es="Lo que Lhassa ya es, no lo que promete ser." en="What Lhassa already is, not what it promises to be." /></h2>
        <div class="trait-grid">
          <div class="trait" data-reveal>
            <p class="n">#01 · <Bi es="Persiste" en="Persists" /></p>
            <h3><Bi es="Identidad más allá del modelo." en="Identity beyond the model." /></h3>
            <p class="body">
              <Bi
                es="Los modelos van y vienen: gratuitos, de suscripción, locales. Lhassa nunca depende de uno: la identidad, la memoria y el criterio viven detrás de una interfaz, no cableados a ningún proveedor."
                en="Models come and go: free, subscription, local. Lhassa never depends on one: identity, memory and judgment live behind an interface, never wired to a single provider."
              />
            </p>
          </div>
          <div class="trait" data-reveal style="transition-delay: 0.12s">
            <p class="n">#02 · <Bi es="Duerme" en="Sleeps" /></p>
            <h3><Bi es="Hace y duerme." en="Do and sleep." /></h3>
            <p class="body">
              <Bi
                es="El estado vive en disco, no en la memoria RAM de un proceso que nunca se apaga. Un latido lo despierta cada par de minutos; casi siempre no hay nada que pensar, y vuelve a dormir. Pensar es la excepción, no la regla."
                en="State lives on disk, not in the RAM of a process that never turns off. A heartbeat wakes it every couple of minutes; almost always there is nothing to think, and it sleeps again. Thinking is the exception, not the rule."
              />
            </p>
          </div>
          <div class="trait" data-reveal style="transition-delay: 0.24s">
            <p class="n">#03 · <Bi es="Se gana la confianza" en="Earns trust" /></p>
            <h3><Bi es="Autonomía con evidencia." en="Autonomy earned with evidence." /></h3>
            <p class="body">
              <Bi
                es="Todo lo que escribe para sí mismo corre primero en cuarentena, sin red, sin datos. Solo se gradúa si pasa compuertas objetivas (nunca un modelo juzgando a otro modelo) y un humano aprueba. La confianza se degrada por contagio; nunca se promueve sola."
                en="Everything it writes for itself runs first in quarantine, no network, no data. It only graduates by passing objective gates (never one model judging another) and a human approves. Trust degrades by contagion; it is never self-promoted."
              />
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="estado" class="estado">
      <div class="inner narrow">
        <div class="section-rule" data-reveal><p class="label"><Bi es="Estado honesto de construcción" en="Honest state of construction" /></p><span class="dot" aria-hidden="true"></span></div>
        <h2 data-reveal><Bi es="La honestidad es la estética." en="Honesty is the aesthetic." /></h2>
        <div class="metrics" data-reveal>
          <div class="metric"><p class="value">v{version}</p><p class="name"><Bi es="versión real" en="real version" /></p></div>
          <div class="metric"><p class="value">1 400+</p><p class="name">tests</p></div>
          <div class="metric"><p class="value">5</p><p class="name"><Bi es="monjes activos" en="active monks" /></p></div>
          <div class="metric"><p class="value">MIT</p><p class="name"><Bi es="licencia" en="license" /></p></div>
        </div>
        <p class="body" data-reveal>
          <Bi
            es="Hoy existe: un cerebro en uso real y diario, que piensa lo mínimo indispensable, recuerda en capas (hechos, episodios, memoria semántica), se escribe sus propias herramientas bajo cuarentena, y tiene adentro una organización propia de &ldquo;monjes&rdquo; que reportan hacia arriba."
            en="What exists today: a brain in real, daily use, thinking only when strictly necessary, remembers in layers (facts, episodes, semantic memory), writes its own tools under quarantine, and holds inside it an organization of its own &ldquo;monks&rdquo; reporting upward."
          />
        </p>
        <p class="gold-note" data-reveal>
          <Bi
            es="El oro del templo, del que este sitio nocturno es apenas el umbral."
            en="The gold of the temple, of which this nightly site is only the threshold."
          />
        </p>
        <p class="body" data-reveal>
          <Bi
            es="En camino: Lhassa es código abierto y hoy puede instalarse desde el repositorio. Lo que se está puliendo es todo lo demás: la experiencia de instalación para cualquiera, la documentación de primeros pasos, un plan público. Este sitio no es un producto terminado: es la promesa de que se está construyendo, en público, con honestidad de etapa."
            en="In progress: Lhassa is open source and can be installed from the repository today. What is being polished is everything around that: the install experience for anyone, the first-steps documentation, a public plan. This site is not a finished product. It is the promise that it is being built, in public, with honesty about its stage."
          />
        </p>
      </div>
    </section>


    <section id="distinto" class="distinto">
      <div class="inner">
        <div class="section-rule" data-reveal><p class="label"><Bi es="Distinto por diseño" en="Different by design" /></p><span class="dot" aria-hidden="true"></span></div>
        <h2 data-reveal><Bi es="No es otro agente. Es otra pregunta." en="Not another agent. Another question." /></h2>
        <p class="body" data-reveal style="max-width: 62ch; margin-bottom: 1em;">
          <Bi
            es="Admiramos a proyectos como Hermes de Nous Research: agentes potentes, listos para instalar, siempre dispuestos a pensar. Lhassa nace de una pregunta distinta: ¿cuánto puede hacer un cerebro que casi nunca piensa, que no le pertenece a ningún proveedor, y que se gana cada permiso?"
            en="We admire projects like Nous Research&rsquo;s Hermes: powerful agents, ready to install, always willing to think. Lhassa starts from a different question: how much can a brain do if it almost never thinks, belongs to no provider, and earns every permission?"
          />
        </p>
        <div class="trait-grid">
          <div class="trait" data-reveal>
            <p class="n">Δ1 · <Bi es="Piensa menos" en="Thinks less" /></p>
            <h3><Bi es="Dormir es el estado natural." en="Sleeping is the natural state." /></h3>
            <p class="body">
              <Bi
                es="Un agente siempre listo paga tokens por estar listo. Lhassa invierte la premisa: vive dormida a costo cero, y pensar (gastar) es la excepción que el criterio debe justificar. La factura de ayer se muestra en el dashboard, centavo a centavo."
                en="An always-ready agent pays tokens for its readiness. Lhassa inverts the premise: it sleeps at zero cost, and thinking (spending) is the exception judgment must justify. Yesterday&rsquo;s bill shows in the dashboard, cent by cent."
              />
            </p>
          </div>
          <div class="trait" data-reveal style="transition-delay: 0.12s">
            <p class="n">Δ2 · <Bi es="Posee lo esencial" en="Owns the essentials" /></p>
            <h3><Bi es="Nada prestado en el centro." en="Nothing rented at the core." /></h3>
            <p class="body">
              <Bi
                es="La identidad, la memoria, el historial de confianza y el criterio son propios y viven en tu disco. Los modelos y harnesses se alquilan y se cambian sin que Lhassa deje de ser Lhassa. Ningún tercero puede llevarse lo que importa."
                en="Identity, memory, the trust record and judgment are its own, living on your disk. Models and harnesses are rented and swapped without Lhassa ceasing to be Lhassa. No third party can walk away with what matters."
              />
            </p>
          </div>
          <div class="trait" data-reveal style="transition-delay: 0.24s">
            <p class="n">Δ3 · <Bi es="Optimiza antes de crear" en="Optimizes before creating" /></p>
            <h3><Bi es="Se usa lo maduro; se construye el vacío." en="Use what is mature; build the void." /></h3>
            <p class="body">
              <Bi
                es="El cuerpo ya lo construyeron otros y bien: harnesses de código, contabilidad de tokens, modelos. Lhassa los usa y los exprime en vez de competir con ellos, y solo construye lo que no existe: el cerebro persistente que los orquesta con juicio."
                en="The body was already built by others, and well: coding harnesses, token accounting, models. Lhassa uses and squeezes them instead of competing, and only builds what does not exist: the persistent brain that orchestrates them with judgment."
              />
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="abierto" class="abierto">
      <div class="inner narrow">
        <div class="section-rule" data-reveal><p class="label"><Bi es="Código abierto" en="Open source" /></p><span class="dot" aria-hidden="true"></span></div>
        <h2 data-reveal><Bi es="Abierto de verdad: código, documentos y decisiones." en="Truly open: code, documents, and decisions." /></h2>
        <p class="body" data-reveal style="max-width: 62ch;">
          <Bi
            es="Lhassa es MIT y se construye sobre herramientas abiertas; devolver es parte del diseño. El repositorio no trae solo código: trae los documentos que explican cómo piensa, y un registro de decisiones fase a fase, incluidas las que salieron mal."
            en="Lhassa is MIT-licensed and built on open tools; giving back is part of the design. The repository does not just carry code: it carries the documents that explain how it thinks, and a phase-by-phase decisions log, including the ones that went wrong."
          />
        </p>
        <div class="doc-list" data-reveal>
          <p class="doc"><span class="doc-name">concepts.md</span><span class="doc-desc"><Bi es="Las ideas núcleo: hace-y-duerme, las dos memorias, el árbitro, la organización." en="The core ideas: do-and-sleep, the two memories, the arbiter, the org." /></span></p>
          <p class="doc"><span class="doc-name">security.md</span><span class="doc-desc"><Bi es="Confianza, aprobaciones, allowlist, cuarentena y compuertas." en="Trust, approvals, the allowlist, quarantine and the gates." /></span></p>
          <p class="doc"><span class="doc-name">architecture-layers.md</span><span class="doc-desc"><Bi es="Las capas y sus fronteras: un test las hace cumplir, no un documento." en="The layers and their borders: a test enforces them, not a document." /></span></p>
          <p class="doc"><span class="doc-name">narrative.md</span><span class="doc-desc"><Bi es="El libro de voz: la bandera, los pilares, el tono." en="The voice book: the flag, the pillars, the tone." /></span></p>
          <p class="doc"><span class="doc-name">decisions.md</span><span class="doc-desc"><Bi es="El registro vivo de decisiones, fase a fase." en="The living decisions log, phase by phase." /></span></p>
        </div>
        <h3 class="sub-h" data-reveal><Bi es="Cómo aportar" en="How to contribute" /></h3>
        <p class="body" data-reveal style="max-width: 62ch;">
          <Bi
            es="Pequeño y enfocado gana. Tres reglas del CONTRIBUTING real: las dependencias apuntan hacia abajo y un test lo verifica; el plano determinista jamás llama a un modelo (un latido no puede morir por un proveedor); y nada personal entra al árbol, nunca. Mientras Lhassa madura, el mejor aporte es leer los documentos y cuestionar el diseño: consejo, no control, también aplica hacia nosotros."
            en="Small and focused wins. Three rules from the real CONTRIBUTING: dependencies point down and a test verifies it; the deterministic plane never calls a model (a heartbeat cannot die on a provider); and nothing personal ever enters the tree. While Lhassa matures, the best contribution is reading the documents and questioning the design: counsel, not control, applies to us too."
          />
        </p>
        <pre class="devloop" data-reveal><code>make install   <span class="c"># uv sync + dashboard build</span>
make test      <span class="c"># la suite completa / the whole suite</span>
make lint      <span class="c"># ruff</span>
make check     <span class="c"># valida el entorno, sin llamadas API / validates env, no API calls</span></code></pre>
        <p class="body" data-reveal style="max-width: 62ch;">
          <Bi
            es="Construida sobre hombros abiertos: Python y uv, ruff, React y Vite en el dashboard, los harnesses de código que alquila como músculos, y Wikimedia Commons hasta en estas fotos. Gracias."
            en="Built on open shoulders: Python and uv, ruff, React and Vite in the dashboard, the coding harnesses it rents as muscles, and Wikimedia Commons down to these very photos. Thank you."
          />
        </p>
      </div>
    </section>

    <section id="sigue" class="sigue">
      <div class="inner narrow">
        <p class="label" data-reveal><Bi es="Sigue la construcción" en="Follow the construction" /></p>
        <p class="story" data-reveal>
          <Bi
            es="Lhassa se construye a la vista de todos, en un repositorio abierto (MIT). Sigue el avance real (commits, decisiones, lo que se rompió y se reescribió) en las notas de Witara, cuando exista la primera; hasta entonces, en el propio repositorio."
            en="Lhassa is built in the open, in an MIT-licensed repository. Follow the real progress (commits, decisions, what broke and got rewritten) in Witara&rsquo;s notes, once the first one exists; until then, in the repository itself."
          />
        </p>
        <a class="cta" href="https://github.com/Sadriica/Lhassa" rel="noopener">
          <Bi es="Ver el repositorio en GitHub" en="View the repository on GitHub" /> →
        </a>
      </div>
    </section>

    <section id="creditos" class="creditos">
      <div class="inner narrow">
        <div class="section-rule" data-reveal><p class="label"><Bi es="El paisaje del nombre" en="The landscape of the name" /></p><span class="dot" aria-hidden="true"></span></div>
        <p class="body" data-reveal style="max-width: 60ch; margin-bottom: 1em;">
          <Bi
            es="Lhassa se llama así por Lhasa, la ciudad en el techo del mundo. Estas cuatro fotografías del Tíbet y el Himalaya vienen de Wikimedia Commons, tratadas con el pipeline de dithering en la paleta obsidiana del propio dashboard. Un toque revela el color original."
            en="Lhassa is named for Lhasa, the city at the roof of the world. These four photographs of Tibet and the Himalaya come from Wikimedia Commons, treated with the dithering pipeline in the dashboard&rsquo;s own obsidian palette. A touch reveals the original color."
          />
        </p>
        <div class="gallery-grid">
          {photos.map((p, i) => (
            <figure data-hint="hover / touch" data-reveal style={`transition-delay: ${i * 0.1}s`}>
              <div class="frame">
                <img src={`/img/obsidiana/${p.id}.png`} width={p.w} height={p.h} alt={p.title} loading="lazy" decoding="async" />
                <img class="color" src={`/img/color/${p.id}.jpg`} width={p.w} height={p.h} alt="" aria-hidden="true" loading="lazy" decoding="async" />
              </div>
              <figcaption><span><Bi es={p.cap.es} en={p.cap.en} /></span><span>{p.kb} KB · {p.lic}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="credits-list" data-reveal>
          {photos.map((p) => (
            <p class="credit">
              <em>{p.title}</em> · {p.author} · <a href={p.href} rel="noopener">Wikimedia Commons</a> · {p.lic}
            </p>
          ))}
        </div>
      </div>
    </section>

    <footer>
      <a href="https://witara.site" aria-label="Witara" rel="noopener">
        <img src="/brand/logo_web_white.svg" alt="Witara" width="56" height="64" />
      </a>
      <span>Lhassa v{version} · by Witara</span>
      <span><Bi es="Página: 1.1 MB" en="Page: 1.1 MB" /></span>
      <span>Colombia · 2026</span>
      <button type="button" class="lang-toggle" aria-label="Cambiar idioma / Switch language">
        <span class="lang-es">EN</span><span class="lang-en">ES</span>
      </button>
    </footer>
  </main>
</Base>
