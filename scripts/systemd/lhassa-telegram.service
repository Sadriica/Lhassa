# Lhassa: Telegram inbound poller (long-poll getUpdates), from the telegram pack.
#
# Listens for messages from the configured chat and answers them through the
# chat engine (lhassa.chat), replying over Telegram. Needs the lhassa-telegram
# pack installed (uv sync --all-packages). Credential-gated: with no
# LHASSA_TELEGRAM_BOT_TOKEN / LHASSA_TELEGRAM_CHAT_ID / LHASSA_TELEGRAM_POLL=1 in
# the .env it logs once and exits; it never touches the network.
#
# Install as a USER unit (do NOT install system-wide):
#   cp scripts/systemd/lhassa-telegram.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now lhassa-telegram.service
#   journalctl --user -u lhassa-telegram -f      # watch it
#
# Adjust the paths below if your checkout or venv live elsewhere.
[Unit]
Description=Lhassa Telegram inbound poller
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Code/lhassa
ExecStart=%h/Code/lhassa/.venv/bin/python -m lhassa.telegram.poller
Restart=on-failure
RestartSec=10
# Live CV tailoring: run flows against a real model (claude subscription).
Environment=LHASSA_ORG_LIVE=1
Environment=LHASSA_HEARTBEAT_PROVIDER=claude
Environment=LHASSA_CLAUDE_MODEL=claude-sonnet-4-6
Environment=LHASSA_CLI_TIMEOUT=400
# subscription CLIs (claude lives in ~/.local/bin) — the default user-service PATH
# lacks it, and without it the fallback chain silently skips the claude provider.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin

[Install]
WantedBy=default.target
