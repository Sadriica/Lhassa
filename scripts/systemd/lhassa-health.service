# Lhassa — LLM-free PC-state health checks (oneshot, triggered by the timer).
#
# Install as a USER unit (do NOT install system-wide):
#   cp scripts/systemd/lhassa-health.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now lhassa-health.timer
#
# Adjust the paths below if your checkout or venv live elsewhere.
[Unit]
Description=Lhassa LLM-free PC-state health checks
After=graphical-session.target

[Service]
Type=oneshot
WorkingDirectory=%h/Code/potts
ExecStart=%h/Code/potts/.venv/bin/python %h/Code/potts/scripts/lhassa-health
