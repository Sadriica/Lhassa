# Lhassa — runs the PC-state health checks shortly after boot, then every 10 min.
#
# Install as a USER unit (do NOT install system-wide):
#   systemctl --user enable --now lhassa-health.timer
[Unit]
Description=Run Lhassa PC-state health checks periodically

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
AccuracySec=30s
Persistent=true
Unit=lhassa-health.service

[Install]
WantedBy=timers.target
