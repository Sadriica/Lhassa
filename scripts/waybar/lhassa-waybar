def lang(env):
    pick = (env.get("LHASSA_WAYBAR_LANG") or env.get("LANG") or "").lower()
    return "es" if pick.startswith("es") else "en"


def state_path(env):
    override = (env.get("LHASSA_WAYBAR_STATE_FILE") or "").strip()
    if override:
        return override
    runtime = (env.get("XDG_RUNTIME_DIR") or "").strip()
    if runtime and os.path.isdir(runtime):
        return os.path.join(runtime, "lhassa", "waybar.json")
    return os.path.join(tempfile.gettempdir(), "lhassa-%d" % os.getuid(), "waybar.json")


def mode_path(path, env=None):
    """The counter-mode file: next to the state file, so the same privacy applies."""
    override = ((env or {}).get("LHASSA_WAYBAR_MODE_FILE") or "").strip()
    return override or os.path.join(os.path.dirname(path), "waybar-mode")


def esc(text):
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def duration(seconds):
    seconds = int(max(0, seconds))
    if seconds < 60:
        return "%ds" % seconds
    minutes = seconds // 60
    if minutes < 60:
        return "%dm" % minutes
    hours = minutes // 60
    return "%dh%02dm" % (hours, minutes % 60) if hours < 24 else "%dd" % (hours // 24)


def out(text, tooltip, cls):
    return {"text": esc(text), "tooltip": tooltip, "class": cls}


def hidden():
    return {"text": "", "tooltip": "", "class": "hidden"}


def read_state(path, now, env):
    """``(data, None)`` for a fresh state file, else ``(None, (kind, key))`` with
    ``kind`` in idle/stale and ``key`` the tooltip text id."""
    try:
        stale_after = float(env.get("LHASSA_WAYBAR_STALE_S") or 60)
    except ValueError:
        stale_after = 60.0
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return None, ("idle", "no_brain_tip", None)
    except (OSError, ValueError):
        return None, ("idle", "unreadable_tip", None)
    if not isinstance(data, dict) or not isinstance(data.get("written_at"), (int, float)):
        return None, ("idle", "unreadable_tip", None)
    age = max(0.0, now - float(data["written_at"]))
    if age > stale_after:
        return None, ("stale", "stale_tip", duration(age))
    return data, None


def down(t, why):
    kind, key, age = why
    label = "%s %s" % (WHEEL, t["no_brain"])
    return out(label, esc(t[key].format(age=age) if age else t[key]), kind)


def num(data, key, default=0.0):
    value = data.get(key)
    ok = isinstance(value, (int, float)) and not isinstance(value, bool)
    return float(value) if ok else default


def section(data, key):
    value = data.get(key)
    return value if isinstance(value, dict) else {}


def is_v2(data):
    return isinstance(data.get("attention"), dict) or isinstance(data.get("agents"), dict)


def read_mode(path, env):
    try:
        with open(mode_path(path, env), encoding="utf-8") as fh:
            mode = fh.read().strip()
    except OSError:
        return MODES[0]
    return mode if mode in MODES else MODES[0]


def counter(data, mode):
    """The short text beside the icon for ``mode`` ('' when there is nothing to say)."""
    if mode == "agents":
        total = section(data, "agents").get("total")
        return "● %d" % total if isinstance(total, int) and total > 0 else ""
    if mode == "temp":
        temp = section(data, "system").get("temp_c")
        return "%d°" % round(temp) if isinstance(temp, (int, float)) else ""
    if mode == "spend":
        return "$%.2f" % num(data, "cost_usd")
    count = section(data, "attention").get("count")
    return "⚠ %d" % count if isinstance(count, int) and count > 0 else ""


def items_of(data):
    items = section(data, "attention").get("items")
    return [i for i in items if isinstance(i, dict)] if isinstance(items, list) else []


def host_lines(data):
    """``claude-code: repoA, repoB`` lines, one per host, names only."""
    agents = section(data, "agents")
    sessions = agents.get("sessions") if isinstance(agents.get("sessions"), list) else []
    by_host = {}
    for sess in sessions:
        if isinstance(sess, dict) and sess.get("host"):
            by_host.setdefault(str(sess["host"]), []).append(str(sess.get("repo") or ""))
    lines = []
    for host, repos in by_host.items():
        names = {}
        for r in repos:
            if r:
                names[r] = names.get(r, 0) + 1
        detail = ", ".join(n if c == 1 else "%s x%d" % (n, c) for n, c in names.items())
        lines.append("%s %d%s" % (host, len(repos), ": " + detail if detail else ""))
    return lines


def machine_line(data, t):
    sysd = section(data, "system")
    bits = []
    if sysd.get("power_mode"):
        bits.append(str(sysd["power_mode"]))
    if isinstance(sysd.get("temp_c"), (int, float)):
        bits.append("%d°C" % round(sysd["temp_c"]))
    if isinstance(sysd.get("cpu_pct"), (int, float)):
        bits.append("CPU %d%%" % round(sysd["cpu_pct"]))
    if isinstance(sysd.get("battery_pct"), (int, float)):
        bits.append("%d%%%s" % (round(sysd["battery_pct"]), " " + t["charging"] if sysd.get("charging") else ""))
    return " · ".join(bits)


def item_text(item, t):
    kind = str(item.get("kind") or "")
    label = str(item.get("label") or "")
    what = t.get("k_" + kind, kind)
    n = item.get("n")
    extra = " (%d)" % n if isinstance(n, int) and n > 1 else ""
    return "%s: %s%s  [%s]" % (what, label, extra, item.get("source") or "")


def today_line(data, t):
    td = section(data, "today")
    bits = []
    for key, word in (("events", "events"), ("commits", "commits"), ("pushes", "pushes")):
        if isinstance(td.get(key), int):
            bits.append("%d %s" % (td[key], t[word]))
    usd = td.get("api_usd")
    bits.append("%s $%.2f" % (t["api"], usd if isinstance(usd, (int, float)) else num(data, "cost_usd")))
    if td.get("top_repo"):
        bits.append("%s: %s" % (t["top"], td["top_repo"]))
    return " · ".join(bits)


def lhassa_lines(data, t):
    lh = section(data, "lhassa")
    lines = []
    health = [str(n) for n in data.get("health_failing") or []] if isinstance(data.get("health_failing"), list) else []
    lines.append(t["health"].format(names=", ".join(health)) if health else "%s: ok" % t["health"].split(":")[0])
    if lh.get("health") and isinstance(lh.get("digest_age_s"), (int, float)):
        lines.append(t["digest"].format(level=lh["health"], age=duration(lh["digest_age_s"])))
    if lh.get("model"):
        lines.append(t["model"].format(model=lh["model"]))
    return lines


def tooltip_v2(data, t, mode):
    def head(key):
        return "<b>%s</b>" % esc(t[key])

    lines = [head("now")]
    agents = host_lines(data)
    lines += ["  " + esc(x) for x in agents] if agents else ["  " + esc(t["no_agents"])]
    machine = machine_line(data, t)
    if machine:
        lines.append("  " + esc("%s: %s" % (t["machine"], machine)))
    lines += ["", head("attention")]
    items = items_of(data)
    lines += ["  " + esc(item_text(i, t)) for i in items] if items else ["  " + esc(t["nothing"])]
    lines += ["", head("today"), "  " + esc(today_line(data, t))]
    lh = lhassa_lines(data, t)
    if lh:
        lines += ["", head("lhassa")] + ["  " + esc(x) for x in lh]
    lines += ["", esc(t["counter"].format(mode=t["mode_" + mode])), esc(t["click"])]
    return "\n".join(lines)


def render(path, now, env):
    """Return the Waybar dict for the icon at ``path``. Never raises."""
    t = TEXTS[lang(env)]
    data, why = read_state(path, now, env)
    if why:
        return down(t, why)
    if is_v2(data):
        return render_v2(data, path, t, env)
    return render_v1(data, t)


def render_v2(data, path, t, env):
    cls = data.get("class") if data.get("class") in ("ok", "warn", "alert") else "ok"
    mode = read_mode(path, env)
    text = WHEEL
    count = counter(data, mode)
    if count:
        text += " " + count
    return out(text, tooltip_v2(data, t, mode), cls)


def render_v1(data, t):
    cost = num(data, "cost_usd")
    pct = num(data, "pct_used")
    soft = num(data, "soft_pct", 0.8) or 0.8
    approvals = data.get("approvals") if isinstance(data.get("approvals"), int) else None
    tasks = data.get("tasks") if isinstance(data.get("tasks"), int) else None
    failing = data.get("health_failing")
    failing = [str(n) for n in failing] if isinstance(failing, list) else []
    alerting = data.get("health_alert")
    alerting = [str(n) for n in alerting] if isinstance(alerting, list) else []
    budget_on = num(data, "budget") > 0

    cls = "ok"
    if approvals or failing or (budget_on and pct >= soft):
        cls = "warn"
    if alerting or (budget_on and pct >= 1.0):
        cls = "alert"

    text = "%s $%.2f" % (WHEEL, cost)
    if approvals:
        text += " · %d" % approvals

    lines = [t["spent"].format(cost="%.2f" % cost)]
    if budget_on:
        lines.append(t["budget"].format(pct=int(round(pct * 100))))
    if approvals:
        lines.append(t["approvals"].format(n=approvals))
    if tasks:
        lines.append(t["tasks"].format(n=tasks))
    if failing:
        lines.append(t["health"].format(names=", ".join(failing)))
    if cls == "ok":
        lines.append(t["calm"])
    lines.append(t["click"])
    return out(text, esc("\n".join(lines)), cls)


def module(name, path, now, env):
    """The ``agents`` / ``attention`` / ``system`` drawer modules."""
    t = TEXTS[lang(env)]
    data, why = read_state(path, now, env)
    if why or not is_v2(data):
        return hidden()
    if name == "agents":
        agents = section(data, "agents")
        hosts = agents.get("hosts") if isinstance(agents.get("hosts"), dict) else {}
        if not hosts:
            return out(t["agents_short"], esc(t["no_agents"]), "idle")
        text = "  ".join("%s %d" % (h.replace("claude-code", "claude"), n)
                         for h, n in hosts.items() if isinstance(n, int))
        return out(text, esc("\n".join(host_lines(data))), "ok")
    if name == "attention":
        items = items_of(data)
        if not items:
            return hidden()
        kinds = {}
        for i in items:
            kinds[str(i.get("kind") or "")] = kinds.get(str(i.get("kind") or ""), 0) + 1
        text = "⚠ " + " · ".join("%d %s" % (n, t.get("p_" + k, k)) for k, n in kinds.items())
        cls = "alert" if data.get("class") == "alert" else "warn"
        return out(text, esc("\n".join(item_text(i, t) for i in items)), cls)
    sysd = section(data, "system")
    bits = []
    if sysd.get("power_mode"):
        bits.append(str(sysd["power_mode"]))
    if isinstance(sysd.get("temp_c"), (int, float)):
        bits.append("%d°" % round(sysd["temp_c"]))
    if isinstance(sysd.get("cpu_pct"), (int, float)):
        bits.append("%d%%" % round(sysd["cpu_pct"]))
    if isinstance(sysd.get("battery_pct"), (int, float)):
        bits.append("%s%d%%" % ("⚡" if sysd.get("charging") else "", round(sysd["battery_pct"])))
    if not bits:
        return hidden()
    cls = sysd.get("temp_level") if sysd.get("temp_level") in ("ok", "warn", "alert") else "ok"
    return out(" · ".join(bits), esc(machine_line(data, t)), cls)


def dashboard_url(path):
    try:
        with open(path, encoding="utf-8") as fh:
            url = json.load(fh).get("dashboard_url")
    except (OSError, ValueError, AttributeError):
        url = None
    if isinstance(url, str) and url.startswith(("http://127.0.0.1", "http://localhost", "http://[::1]")):
        return url
    return DEFAULT_URL


def section_url(path, section_name=None):
    """The dashboard URL with a ``#<section>`` hash.

    ``section_name`` must be one of :data:`OPEN_SECTIONS`; without one the click picks
    what needs attention: approvals when any wait, else fleet (Readiness) when a
    check or a service is failing, else approvals.
    """
    base = dashboard_url(path).rstrip("/")
    if section_name not in OPEN_SECTIONS:
        section_name = "approvals"
        try:
            with open(path, encoding="utf-8") as fh:
                data = json.load(fh)
            kinds = [i.get("kind") for i in items_of(data)]
            if "approval" in kinds or data.get("approvals"):
                pass
            elif data.get("health_failing") or "service" in kinds or "health" in kinds:
                section_name = "fleet"
        except (OSError, ValueError, AttributeError):
            pass
    return base + "/#" + section_name


def write_mode(path, mode, env):
    """Atomically store the counter mode (0600, directory 0700)."""
    target = mode_path(path, env)
    directory = os.path.dirname(target)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = "%s.%d.tmp" % (target, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(mode + "\n")
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def scroll(path, direction, env, run=subprocess.run):
    step = 1 if direction == "up" else -1
    current = read_mode(path, env)
    nxt = MODES[(MODES.index(current) + step) % len(MODES)]
    write_mode(path, nxt, env)
    signal_waybar(SIG_ICON, run)
    return nxt


def signal_waybar(number, run=subprocess.run):
    try:
        run(["pkill", "-RTMIN+%d" % number, "waybar"], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.SubprocessError):
        pass


# -- the right-click menu ------------------------------------------------------


def which_or(name, *fallbacks):
    found = shutil.which(name)
    if found:
        return found
    for cand in fallbacks:
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def wofi_ask(prompt, options, run=subprocess.run, env=None):
    """Show ``options`` in ``wofi --dmenu``; return the chosen line or ``None``."""
    wofi = which_or("wofi", "/usr/sbin/wofi", "/usr/bin/wofi")
    if not wofi:
        return None
    try:
        proc = run([wofi, "--dmenu", "--prompt", prompt, "--cache-file", "/dev/null"],
                   input="\n".join(options), capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return None
    if getattr(proc, "returncode", 1) != 0:
        return None
    choice = (proc.stdout or "").strip("\n")
    return choice if choice in options else None


def notify(title, body, run=subprocess.run):
    tool = which_or("dunstify", "/usr/bin/dunstify") or which_or("notify-send", "/usr/bin/notify-send")
    if not tool:
        return False
    try:
        run([tool, "-a", "lhassa", title, body], stdin=subprocess.DEVNULL,
            capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    return True


def lhassa_cli(env):
    return (env.get("LHASSA_BIN") or "").strip() or which_or("lhassa", os.path.expanduser("~/.local/bin/lhassa"))


def summary_body(data, t):
    lines = [today_line(data, t)]
    machine = machine_line(data, t)
    if machine:
        lines.append("%s: %s" % (t["machine"], machine))
    items = items_of(data)
    lines += [item_text(i, t) for i in items] if items else [t["nothing"]]
    return "\n".join(lines)


def run_cli(args, env, run=subprocess.run):
    """Run ``lhassa <args>`` (a list: never a shell). ``(ok, text)``."""
    cli = lhassa_cli(env)
    if not cli:
        return False, "lhassa not found"
    try:
        proc = run([cli] + args, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, type(exc).__name__
    text = ((proc.stdout or "") + (proc.stderr or "")).strip().splitlines()
    return getattr(proc, "returncode", 1) == 0, (text[-1] if text else "")


def pending_choices(data, t):
    """``{menu line: (id, label)}`` for approvals that carry an id."""
    out_ = {}
    for i in items_of(data):
        ident = str(i.get("id") or "")
        if i.get("kind") == "approval" and _ID.match(ident):
            out_["%s  [%s]" % (i.get("label") or "approval", ident[:12])] = (ident, str(i.get("label") or "approval"))
    return out_


def menu(path, env, now=None, ask=None, run=subprocess.run):
    """The right-click menu. Every change goes through ``lhassa`` and a wofi confirmation."""
    t = TEXTS[lang(env)]
    ask = ask or (lambda prompt, options: wofi_ask(prompt, options, run, env))
    data, why = read_state(path, time.time() if now is None else now, env)
    data = data or {}
    pending = pending_choices(data, t)
    entries = [t["m_summary"]]
    if pending:
        entries += [t["m_approve"], t["m_deny"]]
    entries += [t["m_open"], t["m_pause"], t["m_power"]]
    choice = ask("Lhassa", entries)
    if choice is None:
        return None
    if choice == t["m_summary"]:
        notify("Lhassa", summary_body(data, t) if data else t["no_brain_tip"], run)
        return "summary"
    if choice in (t["m_approve"], t["m_deny"]):
        approving = choice == t["m_approve"]
        pick = ask(choice, list(pending))
        if pick not in pending:
            return None
        ident, label = pending[pick]
        question = t["q_approve" if approving else "q_deny"].format(what="%s [%s]" % (label, ident[:12]))
        if ask(question, [t["m_yes_approve" if approving else "m_yes_deny"], t["m_cancel"]]) != \
                t["m_yes_approve" if approving else "m_yes_deny"]:
            return None
        ok, text = run_cli(["approve" if approving else "deny", ident], env, run)
        notify("Lhassa", "%s: %s" % (t["done"] if ok else t["failed"], text), run)
        signal_waybar(SIG_ATTENTION, run)
        signal_waybar(SIG_ICON, run)
        return "approve" if approving else "deny"
    if choice == t["m_open"]:
        pick = ask(choice, list(OPEN_SECTIONS))
        if pick in OPEN_SECTIONS:
            open_url(section_url(path, pick))
            return "open:" + pick
        return None
    if choice == t["m_pause"]:
        notify("Lhassa", t["unavailable"], run)
        return "pause-unavailable"
    if choice == t["m_power"]:
        pick = ask(choice, list(POWER_MODES))
        if pick not in POWER_MODES:
            return None
        if ask(t["q_power"].format(mode=pick), [t["m_yes_power"], t["m_cancel"]]) != t["m_yes_power"]:
            return None
        ok, text = run_cli(["action", "run", "power_mode", "--param", "mode=" + pick], env, run)
        notify("Lhassa", "%s: %s" % (t["done"] if ok else t["failed"], text), run)
        signal_waybar(SIG_SYSTEM, run)
        signal_waybar(SIG_ICON, run)
        return "power:" + pick
    return None


def open_url(url):
    try:
        subprocess.Popen(
            ["xdg-open", url],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        return False
    return True


def main(argv, env=None):
    env = os.environ if env is None else env
    command = argv[1] if len(argv) > 1 else "status"
    path = state_path(env)
    if command == "status":
        print(json.dumps(render(path, time.time(), env)))
        return 0
    if command in ("agents", "attention", "system"):
        print(json.dumps(module(command, path, time.time(), env)))
        return 0
    if command == "open":
        return 0 if open_url(section_url(path, argv[2] if len(argv) > 2 else None)) else 1
    if command == "scroll" and len(argv) > 2 and argv[2] in ("up", "down"):
        try:
            scroll(path, argv[2], env)
        except OSError:
            return 1
        return 0
    if command == "menu":
        menu(path, env)
        return 0
    print("usage: lhassa-waybar [status|agents|attention|system|open [section]|menu|scroll up|down]",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
