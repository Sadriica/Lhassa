"""Waybar widget for Lhassa: prints one Waybar JSON object, or opens the dashboard.

    lhassa-waybar [status]   print {"text","tooltip","class"} (for "exec")
    lhassa-waybar open       open the local dashboard in the browser (for "on-click")

It only READS the state file that the running Lhassa process keeps fresh (see
lhassa/views/waybar_state.py and doc/waybar.md); it never imports Lhassa, never
touches the network and never changes anything, so it starts in a few ms and
degrades to a calm "no brain" when Lhassa is down.

Classes: ok, warn (approvals waiting, a health check warning, or budget at the
soft limit), alert (a health check at alert level or budget exhausted), idle (no state file), stale
(state file too old, so Lhassa stopped updating it).
"""

import json
import os
import subprocess
import sys
import tempfile
import time

DEFAULT_URL = "http://127.0.0.1:7766"
WHEEL = "☸"

TEXTS = {
    "en": {
        "no_brain": "no brain",
        "no_brain_tip": "Lhassa is not running (no state file).",
        "unreadable_tip": "Lhassa state file is unreadable.",
        "stale_tip": "Lhassa stopped updating (last update {age} ago).",
        "spent": "Spent today: ${cost}",
        "budget": "Budget used: {pct}%",
        "approvals": "Approvals waiting: {n}",
        "tasks": "Tasks queued: {n}",
        "health": "Health: {names}",
        "calm": "All calm",
        "click": "Click to open the dashboard",
    },
    "es": {
        "no_brain": "sin cerebro",
        "no_brain_tip": "Lhassa no esta corriendo (sin archivo de estado).",
        "unreadable_tip": "El archivo de estado de Lhassa no se puede leer.",
        "stale_tip": "Lhassa dejo de actualizar (ultima vez hace {age}).",
        "spent": "Gasto de hoy: ${cost}",
        "budget": "Presupuesto usado: {pct}%",
        "approvals": "Aprobaciones pendientes: {n}",
        "tasks": "Tareas en cola: {n}",
        "health": "Salud: {names}",
        "calm": "Todo en calma",
        "click": "Clic para abrir el panel",
    },
}


def lang(env):
    pick = (env.get("LHASSA_WAYBAR_LANG") or env.get("LANG") or "").lower()
    return "es" if pick.startswith("es") else "en"


def state_path(env):
    override = (env.get("LHASSA_WAYBAR_STATE_FILE") or "").strip()
    if override:
        return override
    runtime = (env.get("XDG_RUNTIME_DIR") or "").strip()
    if runtime and os.path.isdir(runtime):
        return os.path.join(runtime, "lhassa", "waybar.json")
    return os.path.join(tempfile.gettempdir(), "lhassa-%d" % os.getuid(), "waybar.json")


def esc(text):
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def duration(seconds):
    seconds = int(max(0, seconds))
    if seconds < 60:
        return "%ds" % seconds
    minutes = seconds // 60
    if minutes < 60:
        return "%dm" % minutes
    hours = minutes // 60
    return "%dh%02dm" % (hours, minutes % 60) if hours < 24 else "%dd" % (hours // 24)


def out(text, tooltip, cls):
    return {"text": esc(text), "tooltip": tooltip, "class": cls}


def render(path, now, env):
    """Return the Waybar dict for the state file at ``path``. Never raises."""
    t = TEXTS[lang(env)]
    label = "%s %s" % (WHEEL, t["no_brain"])
    try:
        stale_after = float(env.get("LHASSA_WAYBAR_STALE_S") or 60)
    except ValueError:
        stale_after = 60.0
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return out(label, esc(t["no_brain_tip"]), "idle")
    except (OSError, ValueError):
        return out(label, esc(t["unreadable_tip"]), "idle")
    if not isinstance(data, dict) or not isinstance(data.get("written_at"), (int, float)):
        return out(label, esc(t["unreadable_tip"]), "idle")

    age = max(0.0, now - float(data["written_at"]))
    if age > stale_after:
        return out(label, esc(t["stale_tip"].format(age=duration(age))), "stale")

    def num(key, default=0.0):
        value = data.get(key)
        ok = isinstance(value, (int, float)) and not isinstance(value, bool)
        return float(value) if ok else default

    cost = num("cost_usd")
    pct = num("pct_used")
    soft = num("soft_pct", 0.8) or 0.8
    approvals = data.get("approvals") if isinstance(data.get("approvals"), int) else None
    tasks = data.get("tasks") if isinstance(data.get("tasks"), int) else None
    failing = data.get("health_failing")
    failing = [str(n) for n in failing] if isinstance(failing, list) else []
    alerting = data.get("health_alert")
    alerting = [str(n) for n in alerting] if isinstance(alerting, list) else []
    budget_on = num("budget") > 0

    cls = "ok"
    if approvals or failing or (budget_on and pct >= soft):
        cls = "warn"
    if alerting or (budget_on and pct >= 1.0):
        cls = "alert"

    text = "%s $%.2f" % (WHEEL, cost)
    if approvals:
        text += " · %d" % approvals

    lines = [t["spent"].format(cost="%.2f" % cost)]
    if budget_on:
        lines.append(t["budget"].format(pct=int(round(pct * 100))))
    if approvals:
        lines.append(t["approvals"].format(n=approvals))
    if tasks:
        lines.append(t["tasks"].format(n=tasks))
    if failing:
        lines.append(t["health"].format(names=", ".join(failing)))
    if cls == "ok":
        lines.append(t["calm"])
    lines.append(t["click"])
    return out(text, esc("\n".join(lines)), cls)


def dashboard_url(path):
    try:
        with open(path, encoding="utf-8") as fh:
            url = json.load(fh).get("dashboard_url")
    except (OSError, ValueError, AttributeError):
        url = None
    if isinstance(url, str) and url.startswith(("http://127.0.0.1", "http://localhost", "http://[::1]")):
        return url
    return DEFAULT_URL


def main(argv, env=None):
    env = os.environ if env is None else env
    command = argv[1] if len(argv) > 1 else "status"
    path = state_path(env)
    if command == "status":
        print(json.dumps(render(path, time.time(), env)))
        return 0
    if command == "open":
        try:
            subprocess.Popen(
                ["xdg-open", dashboard_url(path)],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            return 1
        return 0
    print("usage: lhassa-waybar [status|open]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
