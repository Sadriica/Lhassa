<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lhassa.app</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>uv</string>
    <string>run</string>
    <string>python</string>
    <string>docker/run_api.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/Code/lhassa</string>

  <!-- Subscription CLIs (claude/codex/opencode) and Homebrew live outside the
       minimal launchd PATH; the routine think path shells them. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/USERNAME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/com.lhassa.app.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.lhassa.app.err.log</string>
</dict>
</plist>
